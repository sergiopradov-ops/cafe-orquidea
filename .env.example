# URL pública del sitio (metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contacto visible en el sitio
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000
NEXT_PUBLIC_CONTACT_EMAIL=contacto@orquidea.cafe

# Formularios. En Cloud Run: RESEND_API_KEY viene de Secret Manager y el resto
# de Terraform / variables de GitHub. En local, sin estas variables los correos
# se escriben en consola y reCAPTCHA se omite.
# RESEND_API_KEY=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# LEADS_INBOX_EMAIL=
# EMAIL_FROM="Café Orquídea <hola@cafeorquidea.mx>"
